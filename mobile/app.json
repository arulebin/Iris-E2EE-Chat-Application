{
  "expo": {
    "name": "Iris",
    "slug": "iris-mobile",
    "scheme": "iris",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://129-225-92-235.sslip.io/updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "extra": {
      "iris": {
        "distribution": "sideload"
      }
    },
    "backgroundColor": "#f7f8fb",
    "ios": {
      "bundleIdentifier": "com.iris.chat.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Iris uses the camera to take photos and videos you send in chats.",
        "NSMicrophoneUsageDescription": "Iris uses the microphone to record sound in videos you send."
      }
    },
    "android": {
      "package": "com.iris.chat.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#7C5CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f8fb",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0b0d12"
          }
        }
      ],
      "react-native-quick-crypto",
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-video",
      "expo-image",
      "react-native-compressor",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Iris needs access to your photos so you can choose what to send.",
          "savePhotosPermission": "Iris saves photos and videos to your library only when you tap Save.",
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./modules/iris-calls/plugin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
