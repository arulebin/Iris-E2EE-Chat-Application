# Secrets — never commit
.env
.env.*
!.env.example

# Backend build artifacts (covered by backend/.gitignore too, but explicit at root is safer)
backend/target/
backend/data/

# Frontend build artifacts
frontend/dist/
frontend/node_modules/

# IDE
.idea/
*.iml
.vscode/

# Untracked/Unwanted Root files
front-end-logs.txt
node_modules/
/mobile/android/
/mobile/ios/
PROGRESS.md
SUMMARY.md
.claude/
!.env.*.example
local.properties

# OTA code-signing PRIVATE keys and local publish output - never commit
.ota-dev/
.ota-keys/
**/private-key.pem
*.private.pem
*-private-key.pem
ota-out/
