# Copy to .env.android and point at your public backend (must be https/wss).
# The Android app is served from https://localhost, so relative URLs won't reach the API.
VITE_API_BASE_URL=https://your-backend.example.com
# Optional — derived from VITE_API_BASE_URL when omitted.
# VITE_WS_BASE_URL=wss://your-backend.example.com

# Set to true once android/app/google-services.json is in place (see docs/android-push.md).
# Leave unset otherwise — registering for FCM without it crashes the app.
# VITE_ANDROID_PUSH=true
