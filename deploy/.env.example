# Copy to ~/iris/.env on the server (deploy.sh generates one on first run).
# Never commit the real file.

# Public hostname Caddy gets a certificate for (no scheme).
IRIS_DOMAIN=129-225-92-235.sslip.io

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (must decode to exactly 32 bytes)
MEDIA_MASTER_KEY=

# Web Push identity (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Origins allowed to call the API: the Vercel site and the Android app's WebView.
CORS_ALLOWED_ORIGINS=https://iris-chat-web.vercel.app,https://localhost

# Optional — Cloudflare TURN for calls behind strict NATs.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional — FCM for the Android app (see docs/android-push.md).
# Put the service-account JSON in ~/iris/secrets/ and set:
# FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=
