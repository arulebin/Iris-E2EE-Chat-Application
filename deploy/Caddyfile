# The WebSocket authenticates with ?token=<JWT>, and Caddy's error log (e.g. a 502
# while the backend restarts) records the request URI. Strip the token from every
# log line. (Authorization/Cookie headers are already redacted by Caddy.)
{
	log default {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
}

# Automatic HTTPS (Let's Encrypt) for the API + WebSocket endpoint.
# IRIS_DOMAIN comes from .env — e.g. api.yourdomain.tech, or <ip-with-dashes>.sslip.io
# until you have a domain. WebSocket upgrades are proxied automatically.
{$IRIS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Matches Spring's 50 MB media limit (+ multipart overhead).
	request_body {
		max_size 52MB
	}

	# OTA update server (optional "updates" compose profile; 502 here if it isn't
	# running, which the app treats as "no update"). Serves only pre-signed artifacts.
	handle_path /updates/* {
		reverse_proxy updates:8081
	}

	handle {
		reverse_proxy backend:8080
	}
}
